# Steam Workshop Scraper Configuration

api:
  key: "YOUR_API_KEY_HERE" # Can be overridden by STEAM_API_KEY env var

database:
  path: "workshop.db"

daemon:
  api_batch_size: 10
  api_delay_seconds: 1.5
  target_appids:
    - 294100 # RimWorld
  # Database backups are OFF unless both keys below are set.
  # outbox_dir: "outbox"
  # backup_interval_seconds: 3600

openai:
  api_key: "YOUR_OPENAI_API_KEY_HERE" # Can be overridden by OPENAI_API_KEY env var
  endpoint: "https://api.openai.com/v1"
  model: "gpt-4o-mini"
  # Ceiling on fields per translation request: bounds how many rows one bad reply
  # can cost.
  batch_items: 20
  # Ceiling on the summed source length of one request. The first field is always
  # taken, so only a single-field request may exceed it.
  batch_char_cap: 4000
  # Translation is not a creative task; sampling only adds variance.
  temperature: 0.0

logging:
  level: "INFO"
  file: "scraper.log"

# Optional. Windows only. Steam workshop *content* folders to check in addition
# to the ones discovered from Steam's own install (the registry's SteamPath and
# its libraryfolders.vdf). Each entry is the root that holds
# <consumer_appid>/<workshop_id>/ folders:
#   <library>\steamapps\workshop\content
# Use single quotes or double the backslashes in double-quoted YAML.
# steam:
#   workshop_content_dirs:
#     - 'D:\SteamLibrary\steamapps\workshop\content'

