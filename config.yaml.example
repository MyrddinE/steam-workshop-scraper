# Steam Workshop Scraper Configuration

api:
  key: "YOUR_API_KEY_HERE" # Can be overridden by STEAM_API_KEY env var

database:
  path: "workshop.db"

daemon:
  batch_size: 10
  api_delay_seconds: 1.5
  target_appids:
    - 294100 # RimWorld
  # Database backups are OFF unless both keys below are set.
  # outbox_dir: "outbox"
  # backup_interval_seconds: 3600

openai:
  api_key: "YOUR_OPENAI_API_KEY_HERE" # Can be overridden by OPENAI_API_KEY env var
  endpoint: "https://api.openai.com/v1"
  model: "gpt-4o-mini"

logging:
  level: "INFO"
  file: "scraper.log"
